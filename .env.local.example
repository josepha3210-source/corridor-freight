# Copy this file to .env.local and fill in the values from your Supabase project
# Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — no NEXT_PUBLIC_ prefix, so Next.js never bundles this into
# the browser. This is the service_role secret key, not the anon key: it
# bypasses Row Level Security entirely. Only used server-side, to send
# team invite emails (app/dashboard/settings/invite/route.ts). Never
# commit this value or expose it to any client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
